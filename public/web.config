<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Angular SPA" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
            <!-- A request for a missing asset must 404, not fall through to index.html.
                 Without this, a stale index.html pointing at a deleted bundle pulls HTML
                 into a <script> tag instead of failing cleanly, and any legacy service
                 worker on this origin becomes immortal: the browser unregisters a worker
                 whose script 404s, but keeps one whose script answers 200 text/html. -->
            <add input="{REQUEST_URI}" pattern="\.(js|mjs|css|map|json|txt|xml|ico|png|jpe?g|gif|svg|webp|avif|woff2?|ttf|otf|eot|webmanifest)(\?|$)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <!-- Long cache for everything by default. Safe because `outputHashing: all`
           makes every JS/CSS filename content-addressed: a new build emits new
           filenames, so a 1-year cache can never serve stale code. -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>

  <!-- THE fix for "users keep seeing the old version after a deploy".
       The hosting applies `Cache-Control: max-age=31536000` to every static file,
       index.html included, so browsers never revalidate it. A stale index.html keeps
       pointing at the previous build's hashed bundles (still on disk, `clean: false`),
       so the app loads fine and the new release is simply never picked up.
       index.html is the pointer to everything else: it must always be revalidated. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Polled by VersionCheckService to detect a new deploy. A cached copy would
       report the old release forever, so it must always be revalidated. -->
  <location path="version.json">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- One-shot repair for browsers poisoned between 2026-08-13 and 2026-08-28,
       while the hosting still served index.html with `max-age=31536000`. Those
       entries stay fresh until 2027 and are never revalidated: the browser makes
       no request at all, so no header we set on `/` can ever reach it. Measured
       on the sibling panel (`dominodo.admin`) with Cloudflare RUM — `dt: "cache"`,
       `transferSize: 0` on a cold load of `/` — same hosting, same window.

       This URL is new, so it cannot be in anyone's cache, so it is always fetched.
       `Clear-Site-Data` then wipes the whole origin cache, poisoned index.html
       included, and reset-cache.html redirects to `/` for a clean load.

       Only "cache" on purpose: "storage" or "*" would also drop localStorage and
       log every user out. Uncacheable itself, or the second visit would be served
       from cache and the header would never arrive.

       Scope is the origin, so each tenant subdomain clears independently — the
       rescue link must use the affected tenant's own host. Reachable by hand and
       fetched once, silently, by `core/version/cache-heal.ts`. -->
  <location path="reset-cache.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <add name="Clear-Site-Data" value="&quot;cache&quot;" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!-- Copied verbatim from public/, so it is not content-hashed. Short TTL. -->
  <location path="favicon.ico">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
